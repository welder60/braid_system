# ===========================================================================
# Configuração de ambiente do Braid System
# ---------------------------------------------------------------------------
# Copie este arquivo para .env e ajuste os valores.
#   - Desenvolvimento: basta DEBUG=True (usa SQLite + storage local).
#   - Produção:        DEBUG=False e preencha todas as variáveis abaixo.
# ===========================================================================

# Interruptor de ambiente.
#   True  -> desenvolvimento: SQLite local + arquivos em media/
#   False -> produção:        PostgreSQL (Supabase) + Supabase Storage
DEBUG=True

# ---------------------------------------------------------------------------
# Obrigatório APENAS em produção (DEBUG=False)
# ---------------------------------------------------------------------------

# Chave secreta do Django. Gere uma nova, por exemplo:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Hosts e origens permitidos (separados por vírgula).
ALLOWED_HOSTS=braidsystem-development.up.railway.app
CSRF_TRUSTED_ORIGINS=https://braidsystem-development.up.railway.app

# Redirecionar HTTP -> HTTPS (deixe True atrás do proxy do Railway).
SECURE_SSL_REDIRECT=True

# --- Banco de dados PostgreSQL (Supabase) ----------------------------------
# Connection string do Supabase. Use o pooler (Supavisor), porta 5432 (session)
# para a aplicação. Pegue em: Supabase > Project Settings > Database.
# Formato:
#   postgresql://postgres.<ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Storage de arquivos (Supabase Storage via protocolo S3) ---------------
# Crie um bucket PÚBLICO no Supabase Storage e gere chaves S3 em:
#   Supabase > Project Settings > Storage > S3 Access Keys.
SUPABASE_STORAGE_BUCKET=media

# Endpoint S3 do projeto. Formato:
#   https://<ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_ENDPOINT=

# Região do projeto Supabase (ex.: sa-east-1, us-east-1).
SUPABASE_S3_REGION=us-east-1

# Chaves de acesso S3 geradas no painel do Supabase.
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# URL pública do projeto (usada para montar as URLs públicas dos arquivos).
# Formato: https://<ref>.supabase.co
SUPABASE_PROJECT_URL=

# ---------------------------------------------------------------------------
# Login com Google (OAuth2 / OpenID Connect) — necessário em qualquer ambiente
# que use o botão "Entrar com Google".
# ---------------------------------------------------------------------------
# Crie um "OAuth 2.0 Client ID" (tipo Web application) em:
#   https://console.cloud.google.com/apis/credentials
# Em "Authorized redirect URIs" cadastre, para cada ambiente:
#   http://localhost:8000/auth/google/callback/        (desenvolvimento)
#   https://<seu-dominio>/auth/google/callback/         (produção)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Papel atribuído a um usuário criado automaticamente no primeiro login Google.
# Opções: admin | profissional | gerente
GOOGLE_OAUTH_DEFAULT_TIPO=profissional
